    "headline": {"x": 84, "y": 210, "max_width": 560, "anchor": "top-left"},
    "product": {"x": 720, "y": 775, "max_width": 650, "max_height": 1040, "anchor": "center"},
    "selling_points": {"x": 80, "y": 590, "max_width": 430, "anchor": "top-left"},
    "price": {"x": 80, "y": 1130, "max_width": 520, "anchor": "top-left"},
    "campaign_period": {"x": 82, "y": 1260, "max_width": 500, "anchor": "top-left"},
    "cta": {"x": 80, "y": 1340, "width": 260, "height": 78, "anchor": "top-left"}
